* {
  box-sizing: border-box;
}

:root {
  --bg-1: #eef6ff;
  --bg-2: #dfeeff;
  --primary: #1f6feb;
  --primary-dark: #174ea6;
  --success: #3bb273;
  --warning: #ffb74d;
  --danger: #ef5b5b;
  --panel: rgba(255, 255, 255, 0.82);
  --line: rgba(114, 146, 198, 0.22);
  --text: #1f2d3d;
  --muted: #5c6d82;
  --shadow: 0 18px 55px rgba(23, 78, 166, 0.14);
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #edf5ff 0%, #dfeeff 28%, #c7e0ff 100%);
  color: var(--text);
}

button, input {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 40px 20px;
}

.fade-in {
  animation: fadeIn 0.7s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.login-screen {
  width: min(1100px, 100%);
  min-height: 680px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
}

.brand-panel {
  background: linear-gradient(135deg, #0f4da8 0%, #1b6fe0 40%, #3e90ff 100%);
  color: white;
  padding: 54px 42px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand-icon {
  width: 62px;
  height: 62px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.3);
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 20px;
}

.brand-panel h1 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 3.1rem);
  letter-spacing: -0.04em;
}

.brand-panel p {
  margin-top: 14px;
  font-size: 1.02rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.brand-panel ul {
  margin: 28px 0 0;
  padding-left: 18px;
  display: grid;
  gap: 12px;
  color: rgba(255, 255, 255, 0.92);
}

.login-card {
  background: rgba(255, 255, 255, 0.7);
  padding: 54px 38px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18px;
}

.eyebrow {
  display: inline-block;
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--primary);
}

.login-card h2,
.panel-header h2,
.topbar h1 {
  margin: 0;
  color: var(--text);
}

.login-card label,
.student-form label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--text);
}

.login-card input,
.student-form input,
.table-header input {
  width: 100%;
  border: 1.4px solid #d3e5ff;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12px;
  padding: 0.9rem 1rem;
  font-size: 0.96rem;
  color: var(--text);
  transition: 0.2s ease;
}

.login-card input:focus,
.student-form input:focus,
.table-header input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(31, 111, 235, 0.12);
}

.btn {
  border: none;
  border-radius: 12px;
  padding: 0.95rem 1.2rem;
  font-weight: 800;
  font-size: 0.94rem;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

.btn:hover {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 12px 24px rgba(31, 111, 235, 0.18);
}

.btn:active {
  transform: translateY(0);
}

.btn-primary {
  background: linear-gradient(135deg, #8ee2a2, #5bc46d);
  color: #133a20;
}

.btn-secondary {
  background: linear-gradient(135deg, #edf5ff, #dfeeff);
  color: var(--primary-dark);
  border: 1px solid rgba(31, 111, 235, 0.12);
}

.btn-block {
  width: 100%;
}

.dashboard-shell {
  width: min(1320px, 100%);
  min-height: 780px;
  display: grid;
  grid-template-columns: 260px 1fr;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.sidebar {
  background: linear-gradient(180deg, #0d3d82 0%, #10396c 100%);
  padding: 28px 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  color: rgba(255,255,255,0.95);
}

.brand-wrap .brand-icon {
  width: 48px;
  height: 48px;
  margin: 0;
  font-size: 1.4rem;
}

.brand-wrap h3 {
  margin: 0;
  font-size: 1.15rem;
}

.brand-wrap span {
  font-size: 0.74rem;
  opacity: 0.8;
}

.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 30px;
}

.nav-item {
  padding: 0.9rem 1rem;
  border: none;
  border-radius: 12px;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.9);
  text-align: left;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.18s ease;
}

.nav-item.active,
.nav-item:hover {
  background: rgba(255,255,255,0.18);
  transform: translateX(2px);
}

.btn-logout {
  width: 100%;
  background: rgba(255,255,255,0.14);
  color: white;
}

.content-area {
  padding: 30px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.topbar h1 {
  font-size: clamp(1.8rem, 2vw, 2.6rem);
  letter-spacing: -0.04em;
}

.top-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 18px;
}

.stat-card {
  background: rgba(255,255,255,0.75);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 20px;
  box-shadow: 0 12px 30px rgba(15, 77, 168, 0.07);
}

.stat-card span {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 8px;
}

.stat-card strong {
  font-size: clamp(1.8rem, 2vw, 2.4rem);
  color: var(--text);
}

.accent-blue {
  background: linear-gradient(135deg, rgba(98, 158, 255, 0.12), rgba(255,255,255,0.8));
}

.accent-green {
  background: linear-gradient(135deg, rgba(118, 212, 142, 0.12), rgba(255,255,255,0.8));
}

.accent-purple {
  background: linear-gradient(135deg, rgba(162, 123, 255, 0.12), rgba(255,255,255,0.8));
}

.panel {
  background: rgba(255,255,255,0.78);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 24px 22px;
  box-shadow: 0 12px 30px rgba(15, 77, 168, 0.06);
}

.panel-header {
  margin-bottom: 18px;
}

.student-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 18px;
}

.button-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.table-header input {
  max-width: 260px;
}

.table-wrap {
  overflow-x: auto;
  border-radius: 14px;
  border: 1px solid rgba(137, 174, 227, 0.25);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}

th, td {
  padding: 14px 12px;
  text-align: left;
  border-bottom: 1px solid rgba(137, 174, 227, 0.18);
}

th {
  background: rgba(129, 191, 255, 0.12);
  color: var(--primary-dark);
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

tbody tr:hover {
  background: rgba(220, 235, 255, 0.36);
}

.row-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.mini-btn {
  border: none;
  padding: 0.5rem 0.7rem;
  border-radius: 8px;
  font-weight: 800;
  cursor: pointer;
}

.edit-btn {
  background: rgba(59, 178, 115, 0.12);
  color: #1f7d52;
}

.delete-btn {
  background: rgba(239, 91, 91, 0.12);
  color: #a83232;
}

.empty-state {
  text-align: center;
  padding: 30px 12px;
  color: var(--muted);
  font-style: italic;
}

@media (max-width: 980px) {
  .login-screen,
  .dashboard-shell {
    grid-template-columns: 1fr;
  }

  .brand-panel {
    padding-bottom: 32px;
  }

  .field-grid,
  .stat-grid {
    grid-template-columns: repeat(2, minmax(160px, 1fr));
  }
}

@media (max-width: 620px) {
  .content-area {
    padding: 20px;
  }

  .field-grid,
  .stat-grid {
    grid-template-columns: 1fr;
  }

  .button-row,
  .top-actions {
    width: 100%;
  }

  .button-row .btn,
  .top-actions .btn {
    width: 100%;
  }
}
